<Window x:Class="BenefitSubsidyDesktop.AnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аналитика заявок" Width="980" Height="720" MinWidth="840" MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Аналитика распределения заявок" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Отдельная форма для графика по категориям льгот, статусам и типам услуг за выбранный период." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Период" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cmbPeriod" SelectionChanged="SelectionChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Группировка" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cmbGroup" SelectionChanged="SelectionChanged"/>
                </StackPanel>
                <Button Grid.Column="2" Content="Обновить" Click="Refresh_Click" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
            <Canvas x:Name="analyticsCanvas" Background="#FBFCFF"/>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14" Margin="0">
            <TextBlock x:Name="txtSummary" Text="" Foreground="{StaticResource MutedBrush}"/>
        </Border>
    </Grid>
</Window>
