<Window x:Class="BenefitSubsidyDesktop.FirebaseSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки Firebase"
        Width="780" Height="620" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="18">
        <Border Style="{StaticResource Card}" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="Подключение Firebase Realtime Database" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Заполни данные своего Firebase-проекта. После сохранения ПК-приложение будет синхронизировать заявки с облачной БД." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <CheckBox x:Name="chkUseFirebase" Content="Использовать настоящую Firebase Database вместо демо-облака" FontWeight="SemiBold" Margin="0,0,0,18"/>

                        <TextBlock Text="Firebase Database URL" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtDatabaseUrl" Margin="0,0,0,12" ToolTip="Например: https://project-default-rtdb.europe-west1.firebasedatabase.app"/>

                        <TextBlock Text="Web API Key" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtApiKey" Margin="0,0,0,12" ToolTip="Project settings → General → Web API Key"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Email оператора" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtOperatorEmail"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Пароль оператора" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="pwdOperatorPassword" Height="36" Padding="10,6"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="UID менеджера, необязательно" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtManagerUid" ToolTip="UID менеджера из Authentication → Users. Можно оставить пустым."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Имя менеджера" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtManagerName"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#F7F9FF" CornerRadius="16" Padding="14" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Что нужно сделать в Firebase" FontWeight="Bold"/>
                                <TextBlock Text="1. Authentication → Sign-in method → включить Email/Password." TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="2. Authentication → Users → создать operator@test.ru / 123456 или свой логин." TextWrapping="Wrap"/>
                                <TextBlock Text="3. Realtime Database → Rules → для проверки поставить: read/write auth != null." TextWrapping="Wrap"/>
                                <TextBlock Text="4. Realtime Database → Data → импортировать firebase_database_import.json и заменить UID-заглушки настоящими UID." TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="Сохранить" Click="Save_Click" Margin="0,0,10,0"/>
                    <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
