<Window x:Class="BenefitSubsidyDesktop.ApplicationFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карточка заявки" Width="900" Height="780" MinWidth="820" MinHeight="680"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="txtTitle" Text="Новая заявка" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Отдельная форма для ввода и редактирования данных. Поля проверяются по регулярным выражениям и справочникам." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22">
                <StackPanel>
                    <TextBlock Text="Основные сведения" FontSize="20" FontWeight="Bold" Margin="0,0,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="ID заявления" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtRequestId" IsReadOnly="True" Background="#F2F5FA"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,12">
                            <TextBlock Text="Дата подачи" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="dpSubmittedAt"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="ФИО заявителя, до 100 символов" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtFullName" MaxLength="100" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="Телефон: +7XXXXXXXXXX" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtPhone" MaxLength="12"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,12">
                            <TextBlock Text="Номер документа, до 50 символов" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtDocument" MaxLength="50"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Адрес подключения, до 150 символов" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtAddress" MaxLength="150" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="Категория льготы" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbCategory"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,12">
                            <TextBlock Text="Тип услуги" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbService"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="Статус заявления" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbStatus"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,12">
                            <TextBlock Text="Приоритет" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbPriority"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="Назначенный менеджер" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbManager"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,12">
                            <TextBlock Text="Служебная метка, скрыта от менеджера" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="cmbSpecialFlag"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Внешний комментарий для менеджера, до 250 символов" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtExternalComment" MaxLength="250" Height="86" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,0,0,12"/>

                    <TextBlock Text="Внутренний комментарий оператора, до 400 символов" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtInternalComment" MaxLength="400" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="После сохранения изменение попадет в локальную очередь и будет отправлено в облако." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <WrapPanel Grid.Column="1">
                    <Button Content="Сохранить" Click="Save_Click" Margin="0,0,8,0"/>
                    <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
