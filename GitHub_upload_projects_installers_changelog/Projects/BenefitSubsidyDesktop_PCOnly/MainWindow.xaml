<Window x:Class="BenefitSubsidyDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ростелеком — рабочее место оператора" Width="1180" Height="760" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,18,0" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <Border Width="70" Height="70" CornerRadius="22" HorizontalAlignment="Left" Background="#EEF2FF">
                        <TextBlock Text="РТ" Foreground="#7952FF" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Ростелеком" FontSize="28" FontWeight="Bold" Margin="0,18,0,2"/>
                    <TextBlock Text="Учет заявок на льготные подключения и субсидии" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,34,0,0">
                    <TextBlock Text="Разделы программы" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>
                    <Button Content="Заявки" Click="OpenApplications_Click" Margin="0,0,0,10"/>
                    <Button Content="Новая заявка" Click="OpenNewApplication_Click" Margin="0,0,0,10"/>
                    <Button Content="Аналитика" Style="{StaticResource SecondaryButton}" Click="OpenAnalytics_Click" Margin="0,0,0,10"/>
                    <Button Content="Экспорт отчетов" Style="{StaticResource SecondaryButton}" Click="OpenExport_Click" Margin="0,0,0,10"/>
                    <Button Content="Журнал логов" Style="{StaticResource SecondaryButton}" Click="OpenLogs_Click" Margin="0,0,0,10"/>
                    <Button Content="Настройки Firebase" Style="{StaticResource SecondaryButton}" Click="OpenFirebaseSettings_Click" Margin="0,0,0,10"/>
                    <Button x:Name="btnToggleCloud" Content="Отключить сеть" Style="{StaticResource SecondaryButton}" Click="ToggleCloud_Click" Margin="0,0,0,10"/>
                    <Button Content="Синхронизировать" Click="Sync_Click"/>
                </StackPanel>

                <Border Grid.Row="2" Background="#F7F9FF" CornerRadius="18" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Статус подключения" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse x:Name="ellCloud" Width="12" Height="12" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="txtCloudStatus" Text="Онлайн" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="txtQueueStatus" Text="Очередь: 0" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Padding="26" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Главное меню системы" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Все функции вынесены в отдельные формы: список заявок, карточка, детали, аналитика, экспорт, логи и Firebase." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Открыть заявки" Click="OpenApplications_Click" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="126"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <UniformGrid Columns="5">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Всего заявок" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="txtStatAll" Text="0" FontSize="32" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="На проверке" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="txtStatCheck" Text="0" FontSize="32" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Срочные" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="txtStatUrgent" Text="0" FontSize="32" FontWeight="Bold" Margin="0,8,0,0" Foreground="#E07000"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Одобрено" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="txtStatApproved" Text="0" FontSize="32" FontWeight="Bold" Margin="0,8,0,0" Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Ожидают отправки" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="txtStatQueue" Text="0" FontSize="32" FontWeight="Bold" Margin="0,8,0,0" Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="26">
                        <StackPanel>
                            <TextBlock Text="Как теперь устроено приложение" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
                            <TextBlock Text="1. В главном окне находится только меню и сводная статистика." TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="2. Список заявок открыт в отдельной форме с поиском, фильтрами и сортировкой." TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="3. Добавление и редактирование выполняется в отдельной карточке заявки." TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="4. Просмотр подробной информации и быстрое изменение статуса вынесены в отдельное окно." TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="5. Аналитика, экспорт, журнал логов и Firebase-настройки больше не смешиваются с таблицей заявок." TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Border Background="#FFF8E6" CornerRadius="16" Padding="14" Margin="0,18,0,0">
                                <TextBlock Text="Внутренние комментарии и служебные метки остаются только в ПК-версии и не должны отображаться менеджеру в мобильном приложении." TextWrapping="Wrap" Foreground="#8C5B00"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="26" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Быстрые действия" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>
                            <Button Content="Добавить заявку" Click="OpenNewApplication_Click" Margin="0,0,0,12"/>
                            <Button Content="Найти / отфильтровать заявки" Style="{StaticResource SecondaryButton}" Click="OpenApplications_Click" Margin="0,0,0,12"/>
                            <Button Content="Построить график" Style="{StaticResource SecondaryButton}" Click="OpenAnalytics_Click" Margin="0,0,0,12"/>
                            <Button Content="Создать отчет" Style="{StaticResource SecondaryButton}" Click="OpenExport_Click" Margin="0,0,0,12"/>
                            <Button Content="Посмотреть логи" Style="{StaticResource SecondaryButton}" Click="OpenLogs_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
