<Window x:Class="BenefitSubsidyDesktop.ApplicationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заявки — поиск, фильтры и управление" Width="1360" Height="820" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Список заявок" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Отдельная форма для просмотра, поиска, фильтрации, сортировки и удаления записей." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="+ Новая" Click="New_Click" Margin="0,0,8,8"/>
                    <Button Content="Редактировать" Style="{StaticResource SecondaryButton}" Click="Edit_Click" Margin="0,0,8,8"/>
                    <Button Content="Подробно" Style="{StaticResource SecondaryButton}" Click="Details_Click" Margin="0,0,8,8"/>
                    <Button Content="Удалить" Style="{StaticResource DangerButton}" Click="Delete_Click" Margin="0,0,0,8"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Глобальный поиск" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtSearch" TextChanged="FilterChanged" ToolTip="ФИО, телефон, адрес, документ, комментарии"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Категория" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cmbFilterCategory" SelectionChanged="FilterChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Статус" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cmbFilterStatus" SelectionChanged="FilterChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,12,0">
                    <TextBlock Text="Услуга" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cmbFilterService" SelectionChanged="FilterChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,12,0">
                    <TextBlock Text="Приоритет" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cmbFilterPriority" SelectionChanged="FilterChanged"/>
                </StackPanel>
                <Button Grid.Column="5" Content="Сброс" Style="{StaticResource SecondaryButton}" Click="ResetFilters_Click" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14">
            <DataGrid x:Name="dgRequests"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      SelectionMode="Single"
                      MouseDoubleClick="DgRequests_DoubleClick"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      RowHeight="42"
                      AlternatingRowBackground="#F8FAFF"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding RequestId}" Width="125"/>
                    <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="220"/>
                    <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="125"/>
                    <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="250"/>
                    <DataGridTextColumn Header="Категория" Binding="{Binding BenefitCategory}" Width="140"/>
                    <DataGridTextColumn Header="Услуга" Binding="{Binding ServiceType}" Width="140"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="125"/>
                    <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="100"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding SubmittedAt, StringFormat=dd.MM.yyyy}" Width="100"/>
                    <DataGridTextColumn Header="Документ" Binding="{Binding DocumentNumber}" Width="130"/>
                    <DataGridTextColumn Header="Метка" Binding="{Binding SpecialFlag}" Width="220"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtStatus" Text="Найдено: 0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                <WrapPanel Grid.Column="1">
                    <Button Content="Синхронизировать" Click="Sync_Click" Margin="0,0,8,0"/>
                    <Button Content="Закрыть" Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
