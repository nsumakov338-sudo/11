<Window x:Class="BenefitSubsidyDesktop.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Экспорт отчетов" Width="760" Height="620" MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Экспорт отчетов" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Отдельная форма для сохранения полного списка заявлений и отчета за период в Excel или Word." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Полный список заявлений" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                <TextBlock Text="Группировка" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="cmbExportGroup" Margin="0,0,0,14"/>
                <WrapPanel Margin="0,0,0,26">
                    <Button Content="Экспорт Excel" Click="ExportExcel_Click" Margin="0,0,10,10"/>
                    <Button Content="Экспорт Word" Style="{StaticResource SecondaryButton}" Click="ExportWord_Click" Margin="0,0,0,10"/>
                </WrapPanel>

                <Separator Margin="0,0,0,22"/>

                <TextBlock Text="Отчет за период" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="С даты" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="dpReportFrom"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="По дату" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="dpReportTo"/>
                    </StackPanel>
                </Grid>
                <Button Content="Экспорт отчета за период" Click="ExportPeriod_Click" HorizontalAlignment="Left"/>

                <Border Background="#F7F9FF" CornerRadius="16" Padding="14" Margin="0,28,0,0">
                    <TextBlock Text="Файлы сохраняются как HTML-документы с расширением .xls или .doc. Excel и Word открывают их как таблицы со стилями и группировкой." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0">
            <Grid>
                <TextBlock x:Name="txtSummary" Text="" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <Button Content="Закрыть" Style="{StaticResource SecondaryButton}" Click="Close_Click" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
