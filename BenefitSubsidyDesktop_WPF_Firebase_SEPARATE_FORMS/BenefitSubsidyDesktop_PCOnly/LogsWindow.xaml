<Window x:Class="BenefitSubsidyDesktop.LogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Журнал действий" Width="980" Height="720" MinWidth="780" MinHeight="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Структурированный журнал действий" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="В логе сохраняются добавление, редактирование, удаление, изменение статуса, ошибки и синхронизация." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
            <TextBox x:Name="txtLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" Background="#FBFCFF"/>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtPath" Text="" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <WrapPanel Grid.Column="1">
                    <Button Content="Обновить" Click="Refresh_Click" Margin="0,0,8,0"/>
                    <Button Content="Открыть папку" Style="{StaticResource SecondaryButton}" Click="OpenFolder_Click" Margin="0,0,8,0"/>
                    <Button Content="Закрыть" Style="{StaticResource SecondaryButton}" Click="Close_Click"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
