<Window x:Class="BenefitSubsidyDesktop.ApplicationDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подробная информация по заявке" Width="820" Height="720" MinWidth="720" MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock x:Name="txtTitle" Text="Заявка" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Отдельная форма просмотра полной информации и быстрого изменения статуса." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="22" Margin="0,0,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="txtDetails" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#FBFCFF" BorderThickness="0" FontSize="14"/>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0">
            <StackPanel>
                <TextBlock Text="Быстрое изменение статуса" FontWeight="Bold" Margin="0,0,0,10"/>
                <WrapPanel>
                    <Button Content="Принято" Style="{StaticResource SecondaryButton}" Click="QuickStatus_Click" Margin="0,0,8,8"/>
                    <Button Content="На проверке" Style="{StaticResource SecondaryButton}" Click="QuickStatus_Click" Margin="0,0,8,8"/>
                    <Button Content="Одобрено" Style="{StaticResource SecondaryButton}" Click="QuickStatus_Click" Margin="0,0,8,8"/>
                    <Button Content="Отказано" Style="{StaticResource SecondaryButton}" Click="QuickStatus_Click" Margin="0,0,8,8"/>
                    <Button Content="Выполнено" Style="{StaticResource SecondaryButton}" Click="QuickStatus_Click" Margin="0,0,8,8"/>
                    <Button Content="Редактировать" Click="Edit_Click" Margin="0,0,8,8"/>
                    <Button Content="Закрыть" Style="{StaticResource SecondaryButton}" Click="Close_Click" Margin="0,0,0,8"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
